# Public browser credentials from Supabase Project Settings > API.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional business details used by CTA links. Use digits only for WhatsApp.
VITE_BUSINESS_PHONE=+40 726 631 898
VITE_WHATSAPP_NUMBER=

# Social links restored from the WordPress footer configuration.
# Replace the platform homepages with the company profile URLs when available.
VITE_FACEBOOK_URL=https://facebook.com
VITE_TWITTER_URL=https://twitter.com
VITE_YOUTUBE_URL=https://youtube.com

# Server-only values for `npm run content:push`; never expose these in Vite.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# TinaCMS (TinaCloud) – get these from https://app.tina.io
TINA_CLIENT_ID=YOUR_TINA_CLIENT_ID
TINA_TOKEN=YOUR_TINA_TOKEN
