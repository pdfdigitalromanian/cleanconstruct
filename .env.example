# Public browser credentials from Supabase Project Settings > API.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional business details used by CTA links. Use digits only for WhatsApp.
VITE_BUSINESS_PHONE=+40 726 631 898
VITE_WHATSAPP_NUMBER=

# Social profile links. Instagram and TikTok remain placeholders until launch.
VITE_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61573669424226
VITE_INSTAGRAM_URL="#"
VITE_TIKTOK_URL="#"

# Server-only values for `npm run content:push`; never expose these in Vite.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# TinaCMS (TinaCloud) – get these from https://app.tina.io
TINA_CLIENT_ID=YOUR_TINA_CLIENT_ID
TINA_TOKEN=YOUR_TINA_TOKEN
