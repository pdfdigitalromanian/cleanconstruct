    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "tinacms": "^3.7.4"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.2.4",
    "@types/node": "^24.10.0",
